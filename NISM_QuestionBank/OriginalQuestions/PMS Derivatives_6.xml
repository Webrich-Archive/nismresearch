<QF id="PMS Derivatives_6" sectionNumber="" articleNumber="0" articleName="">
    <question>
        <text><![CDATA[In-the-money (ITM) call has:]]></text>
        <answers>
            <answer correct="no"><text><![CDATA[Strike > spot]]></text></answer>
            <answer correct="yes"><text><![CDATA[Strike < spot]]></text></answer>
            <answer correct="no"><text><![CDATA[Strike = spot]]></text></answer>
            <answer correct="no"><text><![CDATA[No strike]]></text></answer>
        </answers>
        <explanation><text><![CDATA[**The Logic:** Call ITM when spot > strike (intrinsic value > 0).
**The Trap:** Strike > spot = OTM call.
**Cross-Exam Context:** Same in VIII.
**Distributor's Pro-Tip:** ITM options have higher premium but deeper delta exposure.]]></text></explanation>
    </question>
</QF>
